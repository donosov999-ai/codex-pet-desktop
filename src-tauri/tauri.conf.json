{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biruzik Desktop",
  "version": "0.2.45",
  "identifier": "com.odv999.biruzik",
  "build": {
    "frontendDist": "../src/app",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Biruzik",
        "url": "renderer.html",
        "width": 320,
        "height": 340,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost http://asset.localhost https://mascot.asibots.pro https://donosov999-ai.github.io data:; connect-src 'self' asset: https://asset.localhost http://asset.localhost https://api.github.com https://mascot.asibots.pro https://donosov999-ai.github.io; object-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**",
          "$HOME/.codex/pets/**",
          "../resources/pets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/pets/biruzik": "pets/biruzik",
      "../resources/pets/grovi": "pets/grovi",
      "../resources/pets/asibots": "pets/asibots",
      "../resources/pets/fydao": "pets/fydao",
      "../resources/pets/valya": "pets/valya",
      "../resources/pets/typerighting": "pets/typerighting",
      "../resources/pets/hydro-pump": "pets/hydro-pump",
      "../resources/pets/hydro-scout": "pets/hydro-scout",
      "../resources/pets/hydro-ovo": "pets/hydro-ovo",
      "../resources/pets/hydro-droid": "pets/hydro-droid",
      "../resources/pets/hydro-walker": "pets/hydro-walker",
      "../resources/pets/fox": "pets/fox",
      "../resources/pets/panda": "pets/panda",
      "../resources/pets/bear": "pets/bear",
      "../resources/pets/penguin": "pets/penguin",
      "../resources/pets/owl": "pets/owl",
      "../resources/pets/hedgehog": "pets/hedgehog",
      "../resources/pets/hamster": "pets/hamster",
      "../resources/pets/puppy": "pets/puppy",
      "../resources/pets/wolf": "pets/wolf",
      "../resources/pets/dragon": "pets/dragon",
      "../resources/pets/unicorn": "pets/unicorn",
      "../resources/pets/ghost": "pets/ghost",
      "../resources/pets/slime": "pets/slime",
      "../resources/pets/phoenix": "pets/phoenix",
      "../resources/pets/axolotl": "pets/axolotl",
      "../resources/pets/mushroom": "pets/mushroom",
      "../resources/pets/alien": "pets/alien",
      "../resources/pets/star": "pets/star",
      "../resources/pets/crystal": "pets/crystal",
      "../resources/pets/bug": "pets/bug"
    },
    "windows": {}
  }
}
